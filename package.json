{
  "name": "@moltbot-channel/wechaty",
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "start:test": "node --loader ts-node/esm example/bot-test.ts"
  },
  "description": "Moltbot Wechaty channel plugin for messaging platforms",
  "files": [
    "index.ts",
    "src",
    "clawdbot.plugin.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leochen-g/moltbot-wechaty.git"
  },
  "keywords": [
    "clawdbot",
    "moltbot",
    "feishu",
    "lark",
    "飞书",
    "chatbot",
    "ai",
    "claude",
    "wechaty"
  ],
  "clawdbot": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "wechaty",
      "label": "Wechaty",
      "selectionLabel": "Wechaty",
      "detailLabel": "Wechaty",
      "docsPath": "/channels/wechaty",
      "docsLabel": "wechaty",
      "blurb": "Multi-platform IM support via Wechaty puppets",
      "systemImage": "message.and.waveform",
      "order": 65,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "moltbot-wechaty",
      "localPath": ".",
      "defaultChoice": "npm"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "1.9.14",
    "@juzi/file-box": "^1.8.2",
    "@juzi/wechaty": "^1.0.137",
    "@juzi/wechaty-puppet": "^1.0.130",
    "@juzi/wechaty-puppet-service": "^1.0.113",
    "qrcode-terminal": "^0.12.0",
    "wechaty-puppet-feishu": "^0.0.5",
    "wechaty-puppet-matrix": "^0.0.41",
    "wechaty-puppet-official-account": "^1.10.14",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "clawdbot": "2026.1.24-2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "clawdbot": ">=2026.1.24"
  }
}
